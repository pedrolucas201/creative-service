# Meta API Configuration
META_BASE_URL=https://graph.facebook.com
META_API_VERSION=v24.0
HTTP_TIMEOUT=45s

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/creatives?sslmode=disable
RUN_MIGRATIONS=false

# Storage provider: s3 ou gcs
STORAGE_PROVIDER=s3

# AWS S3 Configuration (quando STORAGE_PROVIDER=s3)
S3_BUCKET=seu-bucket-creative-service
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui

# GCP Cloud Storage (quando STORAGE_PROVIDER=gcs)
GCS_BUCKET=seu-bucket-gcs
GCP_PROJECT_ID=seu-project-id
GCS_CREDENTIALS_JSON=

# Concurrency
MAX_CONCURRENCY=6

# Client Tokens (System User tokens from Meta)
TOKEN_FRANCISCO=your_token_here
TOKEN_CONTIGENCIA01=your_token_here
